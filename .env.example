# Postgres 16 in Docker (docker-compose.yml). Port 5433, not 5432, so it cannot
# collide with a Postgres already running on this machine.
DATABASE_URL=postgresql://credora:credora@127.0.0.1:5433/credora

# AES-256-GCM key for the four encrypted columns (src/db/crypto.ts). 32 bytes, base64.
# The value below is a placeholder and must be replaced before any real data is stored:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Changing it later makes every stored ciphertext permanently unreadable (ADR-013).
FIELD_ENCRYPTION_KEY=UkVQTEFDRS1NRS1nZW5lcmF0ZS15b3VyLW93bi1rZXk=

# Root directory of the local-disk storage adapter (ADR-005). Gitignored; created on
# first write. Which storage adapter is in force is STORAGE_ADAPTER, below.
STORAGE_ROOT=./storage

# Which implementation of each port is in force. Read only by src/integrations/registry.ts
# (INTEGRATIONS.md Rule 3); the valid names for each are the keys of that file's slot table,
# and an unknown value fails at first use with a message listing them.
MESSAGING_ADAPTER=mock
ESIGN_ADAPTER=mock
EXTRACTION_ADAPTER=mock
JUDGE_ADAPTER=mock
BGCHECK_ADAPTER=mock
# mock (HTTP client) | export (CSV files for manual import, ADR-154)
ALAYACARE_ADAPTER=mock
TRAINING_ADAPTER=mock
AGENT_ADAPTER=mock   # | openai (needs OPENAI_API_KEY)

# Local disk is this port's mock, so `local` is the one selection that is not `mock` (ADR-016).
STORAGE_ADAPTER=local

# The local AlayaCare mock server: `npm run mock:alayacare`.
ALAYACARE_BASE_URL=http://localhost:4010

# Only when JUDGE_ADAPTER=claude, which nothing sets by default and CI never sets. Leave it
# unset otherwise: an empty value fails the boot schema on purpose, so that "present but blank"
# cannot be mistaken for "absent".
# ANTHROPIC_API_KEY=

# Only when AGENT_ADAPTER=openai. Leave it unset otherwise (a blank value fails the boot schema).
# OPENAI_API_KEY=

# HS256 key that signs the staff session cookie (src/server/auth/session.ts, ADR-026). At least
# 32 characters, random. The value below is a placeholder and must be replaced:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Changing it signs every staff user out.
SESSION_SECRET=REPLACE-ME-generate-a-random-32-byte-base64-value

# The origin this app is served from; absolute links (e-sign signing URLs, and later invite
# links) are built on it.
APP_URL=http://localhost:3000

# The DocuSeal origin, when ESIGN_ADAPTER=docuseal; agent replies may link to it.
# DOCUSEAL_URL=http://localhost:3001
