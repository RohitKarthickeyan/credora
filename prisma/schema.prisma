  caregiverId String
  /// HMAC-SHA256 (src/lib/otp.ts), never the code.
  codeHash    String
  /// Verification attempts made against this code, right or wrong.
  attempts    Int       @default(0)
  /// Superseding a code sets this to the moment of supersession, as LinkToken does.
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())

  caregiver Caregiver @relation(fields: [agencyId, caregiverId], references: [agencyId, id], onDelete: Cascade)

  @@index([agencyId, caregiverId, createdAt])
  @@schema("core")
}

