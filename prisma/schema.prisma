/// @tier standard
model JobSchedule {
  id       String @id @default(uuid(7))
  agencyId String

  /// Caller-supplied and stable, e.g. "retention.sweep" or
  /// "reference.chase:<referenceId>". Unique per agency: that is what makes createSchedule
  /// idempotent, and it is the part of the occurrence idempotency key that identifies *whose*
  /// schedule this is, which is why JobSchedule needs no caregiverId of its own.
  key String

  /// The handler key enqueued for each occurrence — a Job.type.
  jobType String

  /// Copied verbatim onto every occurrence's Job.payload, and therefore bound by exactly the
  /// same rule: identifiers only, never a field value. This column is plaintext jsonb.
  payload Json

  /// Seconds, not milliseconds. Int is 32-bit, so a millisecond interval would cap at 24.8
  /// days and a monthly-ish schedule would silently overflow. Converted to milliseconds once,
  /// inside resolveScheduleWindow.
  intervalSeconds Int

  /// The next occurrence not yet enqueued, and the only mutable scheduling state. Every
  /// occurrence is this value plus a whole number of intervals, so an occurrence instant is
  /// reproducible from the row and never depends on when a tick happened to run. There is
  /// deliberately no `anchorAt`: the cursor already carries the phase.
  nextOccurrenceAt DateTime

  /// The most recent occurrence actually enqueued; null until the first one is. endSchedule
  /// reads it to cancel the job still outstanding for that occurrence.
  lastOccurrenceAt DateTime?

  /// The schedule produces no occurrence at or after this instant; null runs forever. Stopping
  /// a schedule now is endSchedule, which sets this to now. There is deliberately no second
  /// `isActive` flag: two columns for one concept is two columns that can disagree.
  endsAt DateTime?

  /// Occurrences that came due while nothing was ticking and were deliberately never enqueued.
  /// A tick enqueues only the most recent due occurrence; this counter is what stops that
  /// being silent.
  skippedOccurrences Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Restrict)

  @@unique([agencyId, key])
  @@index([nextOccurrenceAt])
  @@schema("core")
}

