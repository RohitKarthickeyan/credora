  // Nothing keeps the two in step; the template is the authority.
  agencyId   String?
  templateId String

  kind        EvidenceKind
  /// Stable slug for this one way of satisfying the requirement, e.g. TB_PPD_RESULT or
  /// TB_CHEST_XRAY. T-060 emits a document per option; T-074 judges against one.
  evidenceKey String
  /// What the caregiver is asked for, in their words. "PPD skin test result."
  label       String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  template RequirementTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, evidenceKey])
  @@schema("core")
}

// Mirrors LINK_TOKEN_PURPOSES in src/domain/auth/link-token.ts.
enum LinkTokenPurpose {
  INVITE
  REFERENCE_FORM
  STAFF_INVITE

  @@schema("core")
}

/// @tier standard
/// A single-use URL credential for a person with no login (ADR-027). Only the token's SHA-256 is
/// stored, so a database reader cannot mint a working link.
model LinkToken {
  id          String           @id @default(uuid(7))
  agencyId    String
  /// Null exactly for STAFF_INVITE (CHECK in the migration).
  caregiverId String?
  purpose     LinkTokenPurpose
  /// The one row this token authorizes: the Caregiver for INVITE, the
  /// Reference for REFERENCE_FORM, the User for STAFF_INVITE (no FK: users are never deleted, only
  /// deactivated). No foreign key: subjectId names a different table per purpose, so no one FK
  /// can target it, and the tenancy guarantee already comes from the Caregiver relation
  /// (T-022 § Design 2).
  subjectId   String
  tokenHash   String           @unique
  /// Superseding a token sets this to the moment of supersession; there is no revokedAt.
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime         @default(now())

  caregiver Caregiver? @relation(fields: [agencyId, caregiverId], references: [agencyId, id], onDelete: Cascade)

  @@index([agencyId, purpose, subjectId])
  @@schema("core")
}

