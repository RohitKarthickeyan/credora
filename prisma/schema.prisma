datasource db {
  provider = "postgresql"
  schemas  = ["core", "medical", "eeoc"]
}

generator client {
  provider = "prisma-client"
  output   = "../src/db/generated"
}

/// @tier restricted
model MedicalFile {
  id          String   @id @default(uuid(7))
  agencyId    String
  caregiverId String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([agencyId])
  @@schema("medical")
}

/// @tier restricted
model EeocRecord {
  id          String   @id @default(uuid(7))
  agencyId    String
  caregiverId String   @unique
  /// Null means the voluntary form was submitted with this question left blank. The explicit
  /// refusal is DECLINE_TO_SELF_IDENTIFY. A caregiver who was never asked has no row at all.
  gender        EeocGender?
  raceEthnicity EeocRaceEthnicity?
  /// NOT NULL: the row exists only because the voluntary form was submitted.
  submittedAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([agencyId])
  @@schema("eeoc")
}

enum PipelineStage {
  INVITED
  INTAKE
  SIGNING
  DOCUMENT_REVIEW
  VERIFICATION
  CLEARANCE
  SYNCING
  ACTIVE
  WITHDRAWN

  @@schema("core")
}

enum UserRole {
  CAREGIVER
  COORDINATOR
  SUPERVISOR
  AGENCY_ADMIN
  IMPLEMENTATION

  @@schema("core")
}

enum CertificationLevel {
  PCA
  HHA
  CNA

  @@schema("core")
}

enum CredentialType {
  PCA
  HHA
  CNA
  CPR
  TB_CLEARANCE
  PHYSICAL

  @@schema("core")
}

enum CredentialVerificationStatus {
  UNVERIFIED
  VERIFIED
  REJECTED

  @@schema("core")
}

/// @tier standard
model Agency {
  id        String   @id @default(uuid(7))
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  /// The agency's own package code with its background-check vendor, passed through verbatim. Null
  /// means ordering is refused.
  backgroundCheckPackageCode String?
  /// Staff must pass a TOTP second factor at sign-in (SECURITY.md § Sessions). On by default;
  /// no screen turns it off (ADR-144).
  mfaRequired Boolean @default(true)

  users                User[]
  caregivers           Caregiver[]
  jobs                 Job[]
  requirementTemplates RequirementTemplate[]
  schedules            JobSchedule[]
  sentMessages         SentMessage[]
  acceptedIssuers      AcceptedIssuer[]
  webhookSubjects      WebhookSubject[]
  inboundWebhooks      InboundWebhook[]
  alayaCareMapping     AlayaCareMapping?
  staffMfas            StaffMfa[]
  staffRecoveryCodes   StaffRecoveryCode[]

  @@schema("core")
}

/// @tier standard
model User {
  id        String   @id @default(uuid(7))
  agencyId  String
  // Globally unique: staff log in with email + password and no tenant selector
  // (SECURITY.md § Sessions), so the user row is what resolves the agency.
  email     String   @unique
  fullName  String
  role      UserRole
  // T-024 deactivates rather than deletes, so the audit log can still resolve the actor.
  isActive  Boolean  @default(true)
  // bcrypt hash (src/lib/password.ts). Null: no password set, so the user cannot sign in.
  // Selected only by findUserForSignIn in src/db/repositories/users.ts.
  passwordHash String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agency   Agency    @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  staffMfa StaffMfa?

  @@index([agencyId])
  @@schema("core")
}

/// @tier sensitive
model StaffMfa {
  id            String    @id @default(uuid(7))
  agencyId      String
  userId        String    @unique
  /// @tier sensitive @encrypted
  totpSecretEnc Bytes?
  // Null until the first code is confirmed; the secret is then fixed until an admin resets it.
  enrolledAt    DateTime?
  // RFC 6238 § 5.2: the time step of the last accepted code; a step at or below it is refused.
  lastUsedStep  Int?
  // Attempts since the last success, counted before comparing. MFA_MAX_ATTEMPTS locks.
  attempts      Int       @default(0)
  createdAt     DateTime  @default(now())

  agency        Agency              @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  user          User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  recoveryCodes StaffRecoveryCode[]

  @@index([agencyId])
  @@schema("core")
}

/// @tier standard
model StaffRecoveryCode {
  id        String    @id @default(uuid(7))
  agencyId  String
  userId    String
  // sha256 hex of the normalised code (src/lib/recovery-code.ts). The code itself is never stored.
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  agency   Agency   @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  staffMfa StaffMfa @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@unique([userId, codeHash])
  @@index([agencyId])
  @@schema("core")
}

/// @tier standard
model Caregiver {
  id        String        @id @default(uuid(7))
  agencyId  String
  // Explicit state, never derived at read time (ARCHITECTURE.md § State, not inference).
  // Moved only by domain/pipeline (T-015).
  stage     PipelineStage @default(INVITED)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  /// The resolution context (DOMAIN.md), set at invite from src/domain/requirements/vocabulary.ts.
  /// workState is the state whose rules govern the work — not ContactRecord.state, the address.
  /// Nullable only because rows predate T-044; every invited caregiver has workState and
  /// serviceType.
  workState   String?
  serviceType String?
  payer       String?

  /// The caregiver's id on the agency's training platform, set by staff from an unmatched import
  /// row (T-090).
  trainingPlatformId String?

  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Restrict)

  // No name, email or phone here: they are captured exactly once, on IdentityRecord and
  // ContactRecord (DATA-MODEL.md invariant 1). The pipeline list view joins for the name.
  // No field of type MedicalFile or EeocRecord, in either direction: the absence of a relation
  // is what makes an accidental include: impossible (ADR-002, T-002 § Design 3a).
  identity              IdentityRecord?
  contact               ContactRecord?
  conversation          Conversation?
  homeCareProfile       HomeCareProfile?
  payrollInputs         PayrollInputs?
  employment            EmploymentEntry[]
  education             EducationEntry[]
  references            Reference[]
  emergencyContacts     EmergencyContact[]
  careSettingExperience CareSettingExperience[]
  credentials           Credential[]
  signedDocuments       SignedDocument[]
  pipelineEvents        PipelineEvent[]
  linkTokens            LinkToken[]
  requirementInstances  RequirementInstance[]
  oneTimeCodes          OneTimeCode[]
  invites               Invite[]
  uploadedDocuments     UploadedDocument[]
  envelopes             Envelope[]
  attestations          Attestation[]
  checkResults          CheckResult[]
  chrcSubmission        ChrcSubmission?
  backgroundCheckOrder  BackgroundCheckOrder?
  alayaCareSyncs        AlayaCareSync[]
  trainingCompletions   TrainingCompletion[]

  @@unique([agencyId, id])
  @@unique([agencyId, trainingPlatformId])
  @@index([agencyId, stage])
  @@schema("core")
}

/// @tier sensitive
model IdentityRecord {
  id          String @id @default(uuid(7))
  agencyId    String
  caregiverId String

  // The legal name, stored exactly as written — never the comparison-normalised form.
  legalFirstName  String?
  legalMiddleName String?
  legalLastName   String?
  nameSuffix      String?
  otherNames      String[]
  dateOfBirth     DateTime? @db.Date

  /// @tier sensitive @encrypted
  ssnEnc   Bytes?
  ssnLast4 String?

  /// The marker printed on a licence and required by CHRC-102. Deliberately not `gender`: the
  /// voluntary EEOC self-identification is a different fact, lives in the eeoc schema, and is
  /// visible to no role. Never populate one from the other.
  sex            String?
  maritalStatus  String?
  countryOfBirth String?

  heightInches Int?
  weightPounds Int?
  eyeColor     String?
  hairColor    String?

  // Government IDs: columns here, not a fifth satellite. They are identity documents and share
  // the Identity group's tier; I-9 §1, CHRC-102 and identity matching read them with the name.
  hasDriversLicense       Boolean?
  driversLicenseNumber    String?
  driversLicenseState     String?
  driversLicenseExpiresAt DateTime? @db.Date

  workAuthorizationType String?
  /// @tier sensitive @encrypted
  workAuthorizationNumberEnc Bytes?
  workAuthorizationExpiresAt DateTime? @db.Date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  caregiver Caregiver @relation(fields: [agencyId, caregiverId], references: [agencyId, id], onDelete: Cascade)

  @@unique([agencyId, caregiverId])
  @@schema("core")
}

/// @tier standard
model ContactRecord {
  id          String @id @default(uuid(7))
  agencyId    String
  caregiverId String

  // Embedded address columns, named exactly as `Address` in src/domain/validation/address.ts
  // so the repository mapping cannot transpose two fields.
  line1 String?
  line2 String?
  city  String?
  state String?
  zip   String?

  mobilePhone       String?
  alternatePhone    String?
  email             String?
  preferredLanguage String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  caregiver Caregiver @relation(fields: [agencyId, caregiverId], references: [agencyId, id], onDelete: Cascade)

  @@unique([agencyId, caregiverId])
  @@index([agencyId, email])
  @@index([agencyId, mobilePhone])
  // findCaregiversByEmail, the declared unscoped sign-in read (ADR-058).
  @@index([email])
  @@schema("core")
}

/// @tier standard
model HomeCareProfile {
  id          String @id @default(uuid(7))
  agencyId    String
  caregiverId String

  /// Self-asserted at intake. The verified record is Credential — a different fact, not a
  /// duplicate of this one.
  certificationsHeld CertificationLevel[]
  clinicalSkills     String[]
  shiftTypes         String[]
  serviceAreas       String[]
  languages          String[]

  // Nullable on purpose: "not asked yet" and "no" are different answers.
  worksWithPets          Boolean?
  worksWithSmokers       Boolean?
  hasVehicle             Boolean?
  covidVaccinationStatus String?
  /// Vaccination statements (T-084). Allowed values are CHECKed in SQL; printed on the signed Hep B and flu documents.
  hepatitisBChoice     String?
  fluVaccinationChoice String?
  fluDeclinationReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  caregiver Caregiver @relation(fields: [agencyId, caregiverId], references: [agencyId, id], onDelete: Cascade)

  @@unique([agencyId, caregiverId])
  @@schema("core")
}

/// @tier standard
model CareSettingExperience {
  id          String @id @default(uuid(7))
  agencyId    String
  caregiverId String

  setting String
  /// Null until the caregiver enters it; a draft may name a setting first.
  years   Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  caregiver Caregiver @relation(fields: [agencyId, caregiverId], references: [agencyId, id], onDelete: Cascade)

  @@unique([agencyId, caregiverId, setting])
  @@schema("core")
}

/// @tier sensitive
model PayrollInputs {
  id          String @id @default(uuid(7))
  agencyId    String
  caregiverId String

  hourlyRateCents   Int?
  overtimeRateCents Int?
  payFrequency      String?

  w4FilingStatus          String?
  w4MultipleJobs          Boolean?
  w4DependentsAmountCents Int?
  w4OtherIncomeCents      Int?
  w4DeductionsCents       Int?
  w4ExtraWithholdingCents Int?

  it2104FilingStatus            String?
  it2104AllowancesNy            Int?
  it2104AllowancesNyc           Int?
  it2104AllowancesYonkers       Int?
  it2104ExtraWithholdingNyCents Int?
  it2104ResidentNyc             Boolean?
  it2104ResidentYonkers         Boolean?

  bankName        String?
  bankAccountType String?
  /// @tier sensitive @encrypted
  bankRoutingNumberEnc Bytes?
  /// @tier sensitive @encrypted
  bankAccountNumberEnc Bytes?
  bankAccountLast4     String?

  directDepositAuthorizedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  caregiver Caregiver @relation(fields: [agencyId, caregiverId], references: [agencyId, id], onDelete: Cascade)

  @@unique([agencyId, caregiverId])
  @@schema("core")
}

/// @tier standard
model EmploymentEntry {
  id          String @id @default(uuid(7))
  agencyId    String
  caregiverId String

  employerName    String
  positionTitle   String?
  supervisorName  String?
  supervisorPhone String?

  line1 String?
  line2 String?
  city  String?
  state String?
  zip   String?

  startedOn DateTime? @db.Date
  endedOn   DateTime? @db.Date
  // Explicit rather than `endedOn == null`, which cannot tell "still there" from "did not answer".
  isCurrent Boolean   @default(false)

  reasonForLeaving String?
  // The reference flow (T-022) must not call an employer the caregiver asked it not to.
  mayContact       Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  caregiver Caregiver @relation(fields: [agencyId, caregiverId], references: [agencyId, id], onDelete: Cascade)

  @@index([agencyId, caregiverId])
  @@schema("core")
}

/// @tier standard
model EducationEntry {
  id          String @id @default(uuid(7))
  agencyId    String
  caregiverId String

  schoolName      String
  city            String?
  state           String?
  programOrDegree String?
  completedOn     DateTime? @db.Date
  graduated       Boolean?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  caregiver Caregiver @relation(fields: [agencyId, caregiverId], references: [agencyId, id], onDelete: Cascade)

  @@index([agencyId, caregiverId])
  @@schema("core")
}

/// @tier standard
model Reference {
  id          String @id @default(uuid(7))
  agencyId    String
  caregiverId String

  fullName     String
  relationship String?
  employerName String?
  phone        String?
  email        String?

  // ── T-082: the reference check. Written only by src/db/repositories/reference-checks.ts;
  // intake saves write only the columns above.
  requestStatus            ReferenceRequestStatus @default(NOT_REQUESTED)
  escalatedAt              DateTime?
  respondedAt              DateTime?
  workedWith               Boolean?
  wouldRecommend           Boolean?
  responseComments         String?
  /// The staff User who recorded answers taken by phone; null when the reference used the form.
  /// Not a foreign key, like CheckResult.recordedByUserId.
  responseRecordedByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  caregiver Caregiver          @relation(fields: [agencyId, caregiverId], references: [agencyId, id], onDelete: Cascade)
  attempts  ReferenceAttempt[]

  @@unique([agencyId, id])
  @@index([agencyId, caregiverId])
  @@schema("core")
}

/// @tier standard
model EmergencyContact {
  id          String @id @default(uuid(7))
  agencyId    String
  caregiverId String

  fullName       String
  relationship   String?
  phone          String?
  alternatePhone String?
  email          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  caregiver Caregiver @relation(fields: [agencyId, caregiverId], references: [agencyId, id], onDelete: Cascade)

  @@index([agencyId, caregiverId])
  @@schema("core")
}

/// @tier standard
/// A credential recorded at supervisor sign-off from a SATISFIED requirement instance and its
/// accepted upload (ADR-107). instanceId and uploadedDocumentId are set on every row this
/// projection writes.
model Credential {
  id          String @id @default(uuid(7))
  agencyId    String
  caregiverId String

  type      CredentialType
  number    String?
  issuer    String?
  issuedOn  DateTime?      @db.Date
  // A credential expiry is a date, not an instant (CONVENTIONS.md § Code).
  expiresAt DateTime?      @db.Date

  verificationStatus CredentialVerificationStatus @default(UNVERIFIED)
  verifiedAt         DateTime?

  instanceId         String?
  uploadedDocumentId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  caregiver        Caregiver            @relation(fields: [agencyId, caregiverId], references: [agencyId, id], onDelete: Cascade)
  instance         RequirementInstance? @relation(fields: [agencyId, instanceId], references: [agencyId, id], onDelete: Cascade)
  uploadedDocument UploadedDocument?    @relation(fields: [agencyId, uploadedDocumentId], references: [agencyId, id], onDelete: Cascade)

  @@unique([agencyId, instanceId])
  @@index([agencyId, caregiverId])
  @@index([agencyId, expiresAt])
  @@schema("core")
}

/// @tier standard
model SignedDocument {
  id          String @id @default(uuid(7))
  agencyId    String
  caregiverId String

  templateKey     String
  templateVersion String
  envelopeId      String
  // An ADR-005 storage key, not a relation: the storage port owns the bytes.
  signedPdfKey    String
  signedAt        DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  caregiver Caregiver  @relation(fields: [agencyId, caregiverId], references: [agencyId, id], onDelete: Cascade)
  evidence  Evidence[]

  // One envelope carries the whole document set, so rows share an envelopeId. This key is what
  // makes a re-delivered e-sign webhook idempotent instead of duplicating the set.
  @@unique([agencyId, envelopeId, templateKey])
  @@index([agencyId, caregiverId])
  @@schema("core")
}

/// @tier standard
model AuditEntry {
  id       String @id @default(uuid(7))
  agencyId String

  /// Null exactly when actorRole is SYSTEM. Resolves against core."Caregiver" when actorRole
  /// is CAREGIVER and against core."User" otherwise. Deliberately not a foreign key.
  actorId    String?
  actorRole  AuditActorRole
  action     AuditAction
  entityType AuditEntityType
  entityId   String

  /// A column name, never a value (SECURITY.md § Audit log). Shape-enforced in
  /// src/domain/audit/audit-entry.ts.
  fieldName String?
  /// Free text supplied by the actor when a reveal or an override required a justification.
  reason    String?
  /// Absent for a system actor and for anything run off the job queue: there is no request.
  ip        String?

  // No updatedAt: an append-only row is never updated, so the column could only ever lie. No
  // foreign key in any direction either: a Cascade would delete the record of a deletion and a
  // Restrict would make the record undeletable (SECURITY.md § Retention).
  at DateTime @default(now())

  @@index([agencyId, entityType, entityId, at])
  @@index([agencyId, actorId, at])
  @@index([agencyId, at])
  @@schema("core")
}

enum AuditActorRole {
  CAREGIVER
  COORDINATOR
  SUPERVISOR
  AGENCY_ADMIN
  IMPLEMENTATION
  SYSTEM

  @@schema("core")
}

enum AuditAction {
  VIEW
  EDIT
  EXPORT
  SIGN_OFF
  DELETE

  @@schema("core")
}

enum AuditEntityType {
  CAREGIVER
  MEDICAL_FILE
  EEOC_RECORD
  ACCEPTED_ISSUER
  ALAYACARE_MAPPING
  USER
  REQUIREMENT_TEMPLATE
  INBOUND_WEBHOOK
  AUDIT_LOG

  @@schema("core")
}

enum PipelineEventType {
  INTAKE_STARTED
  INTAKE_SUBMITTED
  ENVELOPE_COMPLETED
  DOCUMENT_REVIEW_CLEARED
  VERIFICATION_COMPLETED
  CLEARANCE_GRANTED
  SYNC_COMPLETED
  WITHDRAWAL_RECORDED

  @@schema("core")
}

/// @tier standard
model PipelineEvent {
  id          String @id @default(uuid(7))
  agencyId    String
  caregiverId String

  // Both stages are stored although fromStage is recoverable from the previous row: a report
  // reading one row must not have to order the whole history to know what the row means, and a
  // self-consistent pair is what makes a gap in the history detectable.
  fromStage PipelineStage
  toStage   PipelineStage
  event     PipelineEventType

  /// Null when a webhook or a queue worker moved the stage: no User is responsible for it.
  actorUserId String?
  /// Staff free text. Required for WITHDRAWAL_RECORDED, enforced by the use case rather than by
  /// the column, because the other seven events legitimately have no reason to give.
  reason      String?

  // The only timestamp: the row is written in the same transaction as the fact it records, so
  // "when it happened" and "when we stored it" cannot differ. No updatedAt — append-only.
  occurredAt DateTime @default(now())

  caregiver Caregiver @relation(fields: [agencyId, caregiverId], references: [agencyId, id], onDelete: Cascade)

  // One index, serving both reads that exist: a caregiver's ordered history, and the latest
  // event for "days in stage" (ARCHITECTURE.md § State, not inference).
  @@index([agencyId, caregiverId, occurredAt])
  @@schema("core")
}

enum JobState {
  PENDING
  RUNNING
  SUCCEEDED
  DEAD
  CANCELLED

  @@schema("core")
}

/// @tier standard
model Job {
  id       String @id @default(uuid(7))
  agencyId String

  /// The handler key, e.g. "sync.alayacare". A String rather than an enum: every consumer task
  /// would otherwise have to edit one shared enum concurrently, and the registry in
  /// src/integrations/queue/handler.ts is already the closed list.
  type String

  /// Identifiers only — never a field value. This column is plaintext jsonb and is read by
  /// anyone with a database connection, so an SSN, a bank number or a work-authorisation
  /// number in here would defeat DATA-MODEL.md § Field-level encryption. A sync job carries
  /// { caregiverId }, and the handler reads the record through a repository at run time.
  payload Json

  idempotencyKey String

  state       JobState @default(PENDING)
  /// Attempts that have finished. Incremented when an attempt completes, not when it starts.
  attempts    Int      @default(0)
  maxAttempts Int      @default(8)

  /// The row is invisible to a claimer until this instant. While PENDING it is the next-attempt
  /// time; while RUNNING it is the lease expiry. One column, one meaning: "not before this".
  /// That is what makes a worker that dies mid-job self-healing rather than a stuck queue.
  nextAttemptAt DateTime @default(now())

  claimedAt DateTime?
  claimedBy String?

  /// The most recent failure reason, truncated to MAX_ERROR_LENGTH. Derived: the JobAttempt
  /// rows are the authority. It exists so the dead-letter list renders without a correlated
  /// subquery, and it is written in the same transaction as the attempt row it copies.
  lastError String?

  /// Set when the job reaches SUCCEEDED or DEAD. Null for PENDING and RUNNING.
  finishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agency     Agency       @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  attemptLog JobAttempt[]

  @@unique([agencyId, id])
  @@unique([agencyId, idempotencyKey])
  @@index([state, nextAttemptAt])
  @@index([agencyId, state, createdAt])
  @@schema("core")
}

/// @tier standard
model JobAttempt {
  id       String @id @default(uuid(7))
  agencyId String
  jobId    String

  /// 1-based. Equals the Job.attempts value this attempt produced.
  attempt    Int
  startedAt  DateTime
  finishedAt DateTime
  succeeded  Boolean
  error      String?

  createdAt DateTime @default(now())

  job Job @relation(fields: [agencyId, jobId], references: [agencyId, id], onDelete: Cascade)

  // Not @@unique: requeueJob starts a fresh run with attempts back to 0, so a job that has
  // been revived legitimately has a second attempt 1. startedAt orders the log across runs.
  @@index([agencyId, jobId, attempt])
  @@schema("core")
}

enum RequirementLayer {
  STATE
  SERVICE_TYPE
  ROLE
  PAYER
  AGENCY

  @@schema("core")
}

enum RequirementType {
  FORM
  DOCUMENT
  CHECK
  TRAINING
  ATTESTATION

  @@schema("core")
}

/// The five members of `RequirementInstance 1─n Evidence → UploadedDocument | SignedDocument |
/// CheckResult | TrainingRecord | Attestation` (DATA-MODEL.md § Core entities), member for
/// member. A sixth value here means a sixth arm on that union.
enum EvidenceKind {
  UPLOADED_DOCUMENT
  SIGNED_DOCUMENT
  CHECK_RESULT
  TRAINING_RECORD
  ATTESTATION

  @@schema("core")
}

enum ValidityRule {
  NEVER_EXPIRES
  FROM_EVIDENCE
  FIXED_PERIOD

  @@schema("core")
}

enum RenewalRule {
  NONE
  ON_EXPIRY
  ANNUAL

  @@schema("core")
}

/// @tier standard
model RequirementTemplate {
  id String @id @default(uuid(7))

  // Null means platform-owned: a STATE, SERVICE_TYPE or PAYER rule that Credora ships and
  // every agency reads. This is a declared exception to DATA-MODEL.md invariant 5, recorded in
  // ADR-014; the repository still takes agencyId first and still reads
  // `agencyId IS NULL OR agencyId = :agencyId`. There is no unscoped read.
  agencyId String?

  // The five scope axes (agencyId above is the fifth). Null on an axis means "applies to every
  // value of this axis". `layer` is the narrowest non-null axis and is checked against them by a
  // CHECK constraint.
  state       String?
  serviceType String?
  payer       String?
  role        String?
  layer       RequirementLayer

  // The canonical serialisation of state, serviceType, payer, agencyId and role, produced by
  // scopeKeyOf() in src/domain/requirements/scope.ts. It exists because Postgres treats NULLs as distinct in a
  // unique index, so a unique key over the nullable axes would not stop a duplicate
  // (NULL, 'NY', NULL, NULL) row. It is also the single indexed column T-031 resolves against.
  scopeKey String

  // Identity: `key` is stable across versions and across layers — a narrower template with the
  // same key overrides a broader one. `version` is per (scopeKey, key) and rows are never
  // updated in place; editing publishes version n+1 and retires version n.
  key     String
  version Int    @default(1)

  name        String
  /// Sent verbatim to the judge (SECURITY.md § LLM provider constraints). It must describe the
  /// requirement, never a caregiver: no name, no DOB, no identifier ever belongs in this column.
  description String

  type            RequirementType
  validityRule    ValidityRule
  validityMonths  Int?
  renewalRule     RenewalRule
  blocksClearance Boolean         @default(true)

  /// The single mechanism that keeps a legally person-assigned step away from automation
  /// (SECURITY.md § Regulatory constraints that shape code). Read only through
  /// satisfactionPath() in src/domain/requirements/manual-only.ts.
  manualOnly       Boolean @default(false)
  /// The regulation, named. A CHECK constraint makes it NOT NULL whenever manualOnly is true:
  /// a step kept away from automation must say which rule keeps it there.
  manualOnlyReason String?
  /// The annual minimum in whole minutes (CONVENTIONS: hours are integer minutes). Set only on
  /// TRAINING templates, enforced by a CHECK; T-090 compares imported hours against it.
  minimumMinutes   Int?

  // Set when a newer version is published, or when the rule is withdrawn. Never deleted:
  // materialised instances still point here (DATA-MODEL.md `RequirementInstance n─1
  // RequirementTemplate`), and deleting the row would erase what a caregiver was asked for.
  retiredAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Optional on both sides because agencyId is nullable: a platform-owned template belongs to
  // no tenant. Restrict, matching Caregiver — an agency that still owns a template cannot be
  // deleted out from under it.
  agency           Agency?               @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  acceptedEvidence AcceptedEvidence[]
  instances        RequirementInstance[]

  @@unique([scopeKey, key, version])
  @@unique([id, key])
  @@index([agencyId, key])
  @@schema("core")
}

/// @tier standard
model AcceptedEvidence {
