enum JudgeStaffReason {
  MANUAL_ONLY
  EXPIRED
  EXPIRY_UNKNOWN
  ISSUED_IN_FUTURE
  ISSUED_AFTER_EXPIRY
  VERDICT_INVALID
  VERDICT_UNCERTAIN
  LOW_JUDGE_CONFIDENCE
  MOCK_VERDICT_WITHOUT_ALLOWLIST

  @@schema("core")
}

/// @tier standard
/// The judge step's decision for one document: an allowlist hit (matchedIssuer*) or a judge
/// call (inputHash, verdict, confidence, modelVersion, reasons) — never both (ADR-097).
model JudgeDecision {
  id                 String             @id @default(uuid(7))
  agencyId           String
  uploadedDocumentId String             @unique
  // AcceptedIssuer.id, not a foreign key: entries are retired, never deleted (ADR-041), and the
  // name is snapshotted beside it.
  matchedIssuerId    String?
  matchedIssuerName  String?
  // SHA-256 hex of the redacted input actually sent.
  inputHash          String?
  verdict            JudgeVerdict?
  confidence         Float?
  // The result's modelVersion, never the configured model.
  modelVersion       String?
  // Empty when the document is clinical (they are in medical.ClinicalJudgeReasons) or allowlisted.
  reasons            String[]
  // Empty exactly when the step passes.
  staffReasons       JudgeStaffReason[]
  decidedAt          DateTime           @default(now())

  uploadedDocument UploadedDocument @relation(fields: [agencyId, uploadedDocumentId], references: [agencyId, id], onDelete: Cascade)

  // Prisma requires the one-to-one relation's fields to be unique as a pair.
  @@unique([agencyId, uploadedDocumentId])
  @@schema("core")
}

/// @tier restricted
/// The judge's reasons about a clinic result; they quote clinical text (ADR-082, ADR-098).
model ClinicalJudgeReasons {
  id                 String   @id @default(uuid(7))
  agencyId           String
  caregiverId        String
  // core.UploadedDocument.id; no foreign key crosses the schema boundary.
  uploadedDocumentId String
  reasons            String[]
  createdAt          DateTime @default(now())

  @@unique([agencyId, uploadedDocumentId])
  @@index([agencyId, caregiverId])
  @@schema("medical")
}

// ── T-074: auto-accept decisions ────────────────────────────────────────────────────────────

// Mirrors AUTO_ACCEPT_STAFF_REASONS in src/domain/documents/auto-accept.ts, in order.
enum AutoAcceptStaffReason {
  MANUAL_ONLY
  EXTRACTION_NOT_CONFIDENT
  IDENTITY_NOT_MATCHED
  JUDGE_NOT_RUN
  JUDGE_NOT_PASSED

  @@schema("core")
}

// Mirrors IDENTITY_OUTCOMES in src/domain/identity/match.ts, in order.
enum IdentityOutcome {
  AGREES
  AGREES_WITH_OTHER_NAME
  DIFFERS
  UNREADABLE
  NOT_PRINTED
  NOT_ON_INTAKE

  @@schema("core")
}

/// @tier standard
/// The review decision for one document (ADR-164): returned to the caregiver when returnReason is
/// set (a ReturnReason in src/domain/documents/review-outcome.ts), otherwise sent to staff with
/// staffReasons, possibly none. instanceStatusSet is what it moved the requirement instance to,
/// null when the instance was no longer PENDING (ADR-101).
model AutoAcceptDecision {
  id                 String                  @id @default(uuid(7))
  agencyId           String
  uploadedDocumentId String                  @unique
  staffReasons       AutoAcceptStaffReason[]
  returnReason       String?
  // Snapshots: intake can change later, and a sampler must see "accepted on a former name".
  fullNameOutcome    IdentityOutcome
  dateOfBirthOutcome IdentityOutcome
  instanceStatusSet  InstanceStatus?
  decidedAt          DateTime                @default(now())

  uploadedDocument UploadedDocument @relation(fields: [agencyId, uploadedDocumentId], references: [agencyId, id], onDelete: Cascade)

  // Prisma requires the one-to-one relation's fields to be unique as a pair.
  @@unique([agencyId, uploadedDocumentId])
  @@schema("core")
}

// ── T-080: CHRC submission ──────────────────────────────────────────────────────────────────

/// @tier standard
/// That staff submitted the caregiver's NY DOH criminal history record check request, by whom and
/// when. The result is a CheckResult linked as CHRC_RESULT evidence (ADR-093).
model ChrcSubmission {
  id                String   @id @default(uuid(7))
  agencyId          String
  caregiverId       String
  /// The staff User who recorded it. Not a foreign key, as on CheckResult.recordedByUserId.
  submittedByUserId String
  submittedAt       DateTime @default(now())

  caregiver Caregiver @relation(fields: [agencyId, caregiverId], references: [agencyId, id], onDelete: Cascade)

  @@unique([agencyId, caregiverId])
  @@schema("core")
}

// ── T-123: staff decisions on flagged documents ─────────────────────────────────────────────

// Mirrors STAFF_DECISIONS in src/domain/documents/staff-decision.ts, in order.
enum StaffDecision {
  ACCEPTED
  REJECTED
  REUPLOAD_REQUESTED

  @@schema("core")
}

// Mirrors CAREGIVER_NOTICE_STATUSES in src/domain/documents/staff-decision.ts, in order.
enum CaregiverNoticeStatus {
  QUEUED
  SENT
  REJECTED
  NO_EMAIL
  CANCELLED

  @@schema("core")
}

/// @tier standard
/// Staff's decision on one flagged document from the exception queue: accepted (the requirement is
/// satisfied by it), or returned to the caregiver (rejected / re-upload requested) with the state of
/// the email telling them (ADR-110). A waiver is on the instance, not here.
model StaffDocumentDecision {
  id                 String                 @id @default(uuid(7))
  agencyId           String
  uploadedDocumentId String                 @unique
  decision           StaffDecision
  /// The staff User who decided. Not a foreign key, as on CheckResult.recordedByUserId.
  decidedByUserId    String
  decidedAt          DateTime               @default(now())
  /// null for ACCEPTED; QUEUED at decision for a return, then settled once by review.caregiverNotice.
  caregiverNotice    CaregiverNoticeStatus?
  noticeSettledAt    DateTime?

  uploadedDocument UploadedDocument @relation(fields: [agencyId, uploadedDocumentId], references: [agencyId, id], onDelete: Cascade)

  @@unique([agencyId, uploadedDocumentId])
  @@schema("core")
}

// ── T-081: background check orders ──────────────────────────────────────────────────────────

// Mirrors BACKGROUND_CHECK_ORDER_STATUSES in src/domain/requirements/background-check.ts, in order.
enum BackgroundCheckOrderStatus {
  REQUESTED
  ORDERED
  PENDING
  CLEAR
  CONSIDER

  @@schema("core")
}

/// @tier standard
/// The one background check ordered for a caregiver: who asked, the package code sent, the
/// vendor's order id and its last known status. No report content.
model BackgroundCheckOrder {
  id                String                     @id @default(uuid(7))
  agencyId          String
  caregiverId       String
  /// Not a foreign key, as on CheckResult.
  requestedByUserId String
  requestedAt       DateTime                   @default(now())
  /// As sent; the agency's setting may change later.
  packageCode       String
  /// Null until the order job has placed it.
  vendorOrderId     String?
  status            BackgroundCheckOrderStatus @default(REQUESTED)
  /// When Credora learned CLEAR or CONSIDER (the job's clock).
  resultAt          DateTime?

  caregiver Caregiver @relation(fields: [agencyId, caregiverId], references: [agencyId, id], onDelete: Cascade)

  @@unique([agencyId, caregiverId])
  @@unique([agencyId, vendorOrderId])
  @@schema("core")
}

// ── T-082: reference checks ─────────────────────────────────────────────────────────────────

// Mirrors REFERENCE_REQUEST_STATUSES in src/domain/requirements/reference-check.ts, in order.
enum ReferenceRequestStatus {
  NOT_REQUESTED
  REQUESTED
  RESPONDED
  ESCALATED

  @@schema("core")
}

// Mirrors REFERENCE_ATTEMPT_STATUSES in src/domain/requirements/reference-check.ts, in order.
enum ReferenceAttemptStatus {
  QUEUED
  SENT
  REJECTED
  UNANSWERED

  @@schema("core")
}

/// @tier standard
/// One request emailed to a reference: which try it was, when it went out, and how it ended.
/// A REJECTED or UNANSWERED attempt is a miss.
model ReferenceAttempt {
  id             String                 @id @default(uuid(7))
  agencyId       String
  referenceId    String
  /// 1 or 2.
  number         Int
  status         ReferenceAttemptStatus @default(QUEUED)
  /// The job's clock when the port accepted it.
  sentAt         DateTime?
  /// The port's rejection reason, or NO_CONTACT_DETAILS. Never a message body.
  rejectedReason String?
  createdAt      DateTime               @default(now())

  reference Reference @relation(fields: [agencyId, referenceId], references: [agencyId, id], onDelete: Cascade)

  @@unique([agencyId, referenceId, number])
  @@schema("core")
}

// ── T-090: training hours ───────────────────────────────────────────────────────────────────

/// @tier standard
model TrainingImport {
  id          String   @id @default(uuid(7))
  agencyId    String
  sourceRef   String
  importedAt  DateTime
  /// Well-formed rows the platform sent.
  recordCount Int
  /// Of those, rows not already held.
  addedCount  Int

  rejections TrainingImportRejection[]

  @@unique([agencyId, id])
  @@index([agencyId, importedAt])
  @@schema("core")
}

/// @tier standard
model TrainingImportRejection {
  id       String @id @default(uuid(7))
  agencyId String
  importId String
  line     Int
  reason   String

  import TrainingImport @relation(fields: [agencyId, importId], references: [agencyId, id], onDelete: Cascade)

  @@index([agencyId, importId])
  @@schema("core")
}

/// @tier standard
model TrainingCompletion {
  id                  String   @id @default(uuid(7))
  agencyId            String
  externalCaregiverId String
  // Null until staff link the platform id to a caregiver.
  caregiverId         String?
  courseCode          String
  courseName          String
  completedOn         DateTime @db.Date
  minutes             Int
  importedAt          DateTime

  caregiver Caregiver? @relation(fields: [agencyId, caregiverId], references: [agencyId, id], onDelete: Cascade)
  evidence  Evidence[]

  @@unique([agencyId, externalCaregiverId, courseCode, completedOn])
  @@index([agencyId, caregiverId])
  @@schema("core")
}
